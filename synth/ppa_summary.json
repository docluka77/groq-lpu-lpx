  "low_power_mechanisms": [
    {
      "id": 1,
      "name": "On-Chip 1-Hop Superlane SRAM vs. Off-Chip HBM3e Elimination",
      "rtl_modules": [
        "sram_ip/groq_mem_slice.sv",
        "rtl/groq_stream_fabric.sv"
      ],
      "baseline_pj_per_bit": 4.2,
      "optimized_pj_per_bit_14nm": 0.35,
      "optimized_pj_per_bit_4nm": 0.21,
      "energy_reduction_factor_14nm": 12.0,
      "energy_reduction_factor_4nm": 20.0,
      "power_saved_per_chip_w_14nm": 246.4,
      "power_saved_per_chip_w_4nm": 478.8,
      "description": "Replaces off-chip HBM3e PHY/TSV/interposer DRAM accesses (4.20 pJ/bit = 33.6 pJ/B) with 1-hop spatial stream reads from 44-bank local SRAM slices (0.35 pJ/bit in 14nm, 0.21 pJ/bit in 4nm), eliminating 91.7%-95.0% of weight streaming energy."
    },
    {
      "id": 2,
      "name": "Multi-Bank SRAM Sleep/Retention & Unaddressed Bank Clock Gating",
      "rtl_modules": [
        "sram_ip/groq_sram_macro_sp.sv",
        "sram_ip/groq_mem_slice.sv"
      ],
      "active_banks_per_cycle": 2,
      "total_banks_per_slice": 44,
      "bank_sram_power_reduction_pct": 78.4,
      "power_saved_per_chip_w_14nm": 38.2,
      "power_saved_per_chip_w_4nm": 51.6,
      "description": "Deasserts bank_ce_n (gating icg_en_latched periphery clock) on the 42 unaddressed banks per slice each cycle and asserts slp_n/ds_n source-biased retention on inactive hemisphere weight banks, cutting SRAM leakage and idle periphery power by 78.4%."
    },
    {
      "id": 3,
      "name": "Stream Register valid-Driven Clock Gating & ICU NOP_DELAY Fetch Gating",
      "rtl_modules": [
        "rtl/groq_stream_fabric.sv",
        "rtl/groq_icu_slice.sv"
      ],
      "gated_dffs_per_superlane": 4096,
      "stream_icu_power_reduction_pct": 61.5,
      "power_saved_per_chip_w_14nm": 29.5,
      "power_saved_per_chip_w_4nm": 41.2,
      "description": "Gates all 32x128-bit (4,096 DFFs/hop) East/West stream registers when east_valid_i/west_valid_i is low and deasserts imem_fetch_en_o during deterministic NOP_DELAY(N) countdown cycles, saving 61.5% of stream fabric and VLIW instruction fetch dynamic power."
    },
    {
      "id": 4,
      "name": "MXM & VXM Zero-Skip Operand Isolation (act_zero_gate_en_i)",
      "rtl_modules": [
        "rtl/groq_mxm_slice.sv",
        "rtl/groq_vxm_slice.sv"
      ],
      "mean_activation_sparsity_pct": 46.5,
      "datapath_switching_reduction_pct": 34.8,
      "power_saved_per_chip_w_14nm": 34.6,
      "power_saved_per_chip_w_4nm": 58.4,
      "description": "Detects zero INT8/FP8/FP16 activations per row (lane_is_zero[r]) and isolates multiplier inputs (iso_act_lane[r]=0, iso_wt_mat[r][c]=0) plus VXM mul_op_en/lut_op_en trees, reducing MXM+VXM combinational switching power by 34.8%."
    }
  ],
