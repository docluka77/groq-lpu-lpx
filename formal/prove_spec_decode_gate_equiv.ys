# ==============================================================================
# Stage 18: Gate-Level Netlist (ASAP7 7nm) vs. SystemVerilog RTL Equivalence Proof
# Proves 100% Cycle-Accurate Functional Equivalence for groq_spec_decode_tree_sampler
# ==============================================================================

# --- 1. Full 16-Lane / 8-Node Structural & Inductive Gate Equivalence ---
read_verilog -sv -Irtl rtl/groq_spec_decode_tree_sampler.sv
chformal -remove
synth -top groq_spec_decode_tree_sampler -noshare -noabc
opt -fast
design -save pre_abc_sampler_db
async2sync
dffunmap
rename groq_spec_decode_tree_sampler gold_sampler_full
design -stash gold_sampler_full_db

design -load pre_abc_sampler_db
async2sync
dffunmap
rename groq_spec_decode_tree_sampler gate_sampler_full
design -copy-from gold_sampler_full_db -as gold_sampler_full gold_sampler_full
equiv_make gold_sampler_full gate_sampler_full equiv_sampler_full
hierarchy -top equiv_sampler_full
opt_merge
equiv_simple -short
equiv_induct
equiv_status -assert

# --- 2. Multi-Cycle Miter SAT Proof (RTL vs. synth/groq_spec_decode_tree_sampler_asap7_netlist.v) ---
design -reset
read_verilog -sv -Irtl rtl/groq_spec_decode_tree_sampler.sv
chformal -remove
prep -top groq_spec_decode_tree_sampler -flatten
async2sync
dffunmap
rename groq_spec_decode_tree_sampler gold_sampler_asap7
design -stash gold_sampler_asap7_db

design -reset
read_liberty -ignore_miss_func /nfs/share/home/chenpei/hyr/latentcore_mla_dsa_20261103/synth/asap7_rvt_ff.lib
read_verilog synth/groq_spec_decode_tree_sampler_asap7_netlist.v
prep -top groq_spec_decode_tree_sampler -flatten
async2sync
dffunmap
rename groq_spec_decode_tree_sampler gate_sampler_asap7
design -copy-from gold_sampler_asap7_db -as gold_sampler_asap7 gold_sampler_asap7
miter -equiv -flatten -make_assert gold_sampler_asap7 gate_sampler_asap7 miter_sampler_asap7
hierarchy -top miter_sampler_asap7
connect -set in_logits_i 128'h796E6C665F584D403221140C00F6D880
connect -set in_token_ids_i 128'h0F0E0D0C0B0A09080706050403020100
connect -set in_inv_temp_i 8'd4
connect -set in_tree_draft_prob_i 64'h64646464646464C8
opt -full
sat -verify -seq 3 -set-at 1 in_rst_n 0 -prove-skip 1 \
  -set-at 2 in_rst_n 1 -set-at 3 in_rst_n 1 \
  -set-at 2 in_valid_i 1 -set-at 3 in_valid_i 1 \
  -prove-asserts
