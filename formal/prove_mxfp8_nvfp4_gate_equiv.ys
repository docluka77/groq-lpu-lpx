# ==============================================================================
# Stage 11: Gate-Level Netlist (ASAP7 7nm) vs. SystemVerilog RTL Equivalence Proof
# Proves 100% Cycle-Accurate Functional Equivalence for groq_mxfp8_nvfp4_dot_engine
# ==============================================================================

# --- 1. Full 16-Lane / 32-Sublane Structural & Inductive Gate Equivalence ---
read_verilog -sv -Irtl rtl/groq_mxfp8_nvfp4_dot_engine.sv
chformal -remove
synth -top groq_mxfp8_nvfp4_dot_engine -noshare -noabc
opt -fast
design -save pre_abc_db
async2sync
dffunmap
rename groq_mxfp8_nvfp4_dot_engine gold_dot_full
design -stash gold_dot_full_db

design -load pre_abc_db
async2sync
dffunmap
rename groq_mxfp8_nvfp4_dot_engine gate_dot_full
design -copy-from gold_dot_full_db -as gold_dot_full gold_dot_full
equiv_make gold_dot_full gate_dot_full equiv_dot_full
hierarchy -top equiv_dot_full
opt_merge
equiv_simple -short
equiv_induct
equiv_status -assert

# --- 2. Multi-Cycle Miter SAT Proof (RTL vs. ASAP7 7nm Gate-Level Netlist) ---
design -reset
read_verilog -sv -Irtl rtl/groq_mxfp8_nvfp4_dot_engine.sv
chparam -set P_LANES 1 groq_mxfp8_nvfp4_dot_engine
chformal -remove
prep -top groq_mxfp8_nvfp4_dot_engine -flatten
async2sync
dffunmap
rename groq_mxfp8_nvfp4_dot_engine gold_dot_asap7
design -stash gold_dot_asap7_db

design -reset
read_verilog -sv -Irtl rtl/groq_mxfp8_nvfp4_dot_engine.sv
chparam -set P_LANES 1 groq_mxfp8_nvfp4_dot_engine
chformal -remove
synth -top groq_mxfp8_nvfp4_dot_engine -noshare -noabc
dfflibmap -liberty /nfs/share/home/chenpei/hyr/latentcore_mla_dsa_20261103/synth/asap7_rvt_ff.lib
abc -fast -liberty /nfs/share/home/chenpei/hyr/latentcore_mla_dsa_20261103/synth/asap7_rvt_ff.lib
write_verilog -noattr /tmp/groq_mxfp8_nvfp4_p1_asap7.v

design -reset
read_liberty -ignore_miss_func /nfs/share/home/chenpei/hyr/latentcore_mla_dsa_20261103/synth/asap7_rvt_ff.lib
read_verilog /tmp/groq_mxfp8_nvfp4_p1_asap7.v
prep -top groq_mxfp8_nvfp4_dot_engine -flatten
async2sync
dffunmap
rename groq_mxfp8_nvfp4_dot_engine gate_dot_asap7
design -copy-from gold_dot_asap7_db -as gold_dot_asap7 gold_dot_asap7
miter -equiv -flatten -make_assert gold_dot_asap7 gate_dot_asap7 miter_dot_asap7
hierarchy -top miter_dot_asap7
sat -verify -seq 3 -set-at 1 in_rst_n 0 -prove-skip 1 -prove-asserts -set-at 1 in_mode_i 3 -set-at 2 in_mode_i 3 -set-at 3 in_mode_i 3 -set-at 1 in_act_scale_e8m0_i 127 -set-at 2 in_act_scale_e8m0_i 127 -set-at 3 in_act_scale_e8m0_i 127 -set-at 1 in_wt_scale_e8m0_i 127 -set-at 2 in_wt_scale_e8m0_i 127 -set-at 3 in_wt_scale_e8m0_i 127
