# ==============================================================================
# Stage 23: Gate-Level Netlist (ASAP7 7nm) vs. SystemVerilog RTL Equivalence Proof
# Proves 100% Cycle-Accurate Functional Equivalence for groq_c2c_kv_quant_rx_engine
# ==============================================================================

# --- 1. Full 16-Lane Structural & Inductive Gate Equivalence ---
read_verilog -sv -Irtl rtl/groq_c2c_kv_quant_rx_engine.sv
chformal -remove
synth -top groq_c2c_kv_quant_rx_engine -noshare -noabc
opt -fast
design -save pre_abc_kv_quant_db
async2sync
dffunmap
rename groq_c2c_kv_quant_rx_engine gold_kv_quant_full
design -stash gold_kv_quant_full_db

design -load pre_abc_kv_quant_db
async2sync
dffunmap
rename groq_c2c_kv_quant_rx_engine gate_kv_quant_full
design -copy-from gold_kv_quant_full_db -as gold_kv_quant_full gold_kv_quant_full
equiv_make gold_kv_quant_full gate_kv_quant_full equiv_kv_quant_full
hierarchy -top equiv_kv_quant_full
opt_merge
equiv_simple -short
equiv_induct
equiv_status -assert

# --- 2. Multi-Cycle Miter SAT Proof (RTL vs. synth/groq_c2c_kv_quant_rx_engine_asap7_netlist.v) ---
design -reset
read_verilog -sv -Irtl rtl/groq_c2c_kv_quant_rx_engine.sv
chformal -remove
prep -top groq_c2c_kv_quant_rx_engine -flatten
async2sync
dffunmap
rename groq_c2c_kv_quant_rx_engine gold_c2c_kv_quant
design -stash gold_c2c_kv_quant_db

design -reset
read_liberty -ignore_miss_func /nfs/share/home/chenpei/hyr/latentcore_mla_dsa_20261103/synth/asap7_rvt_ff.lib
read_verilog synth/groq_c2c_kv_quant_rx_engine_asap7_netlist.v
prep -top groq_c2c_kv_quant_rx_engine -flatten
async2sync
dffunmap
rename groq_c2c_kv_quant_rx_engine gate_c2c_kv_quant
design -copy-from gold_c2c_kv_quant_db -as gold_c2c_kv_quant gold_c2c_kv_quant
miter -equiv -flatten -make_assert gold_c2c_kv_quant gate_c2c_kv_quant miter_c2c_kv_quant
hierarchy -top miter_c2c_kv_quant
connect -set in_kv_in_lo_i 128'h4120_4080_4000_3F80_BF80_0000_7F80_3F00
connect -set in_kv_in_hi_i 128'h4200_41A0_4140_40E0_C040_8000_FF80_3E80
opt -full
sat -verify -seq 3 -set-at 1 in_rst_n 0 -prove-skip 1 \
  -set-at 2 in_rst_n 1 -set-at 3 in_rst_n 1 \
  -set-at 2 in_valid_i 1 -set-at 3 in_valid_i 1 \
  -prove-asserts
